{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["App.tsx", "index.ts", "src/**/*.ts", "src/**/*.tsx", "modules/**/*.ts"],
  "exclude": ["node_modules", "android", "ios", "tests"]
}
